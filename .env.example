# ── Free AI ─────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys  (fallback when Gemini rate-limits)
GROQ_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_MODEL=openai/gpt-oss-120b

# ── Supabase (Project Settings → API, and Connect → Session pooler) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Protects /api/ingest (any long random string). Vercel Cron sends it automatically.
CRON_SECRET=
